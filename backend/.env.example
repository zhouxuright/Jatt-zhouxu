# ==============================================================================
# Legal Intelligent Assistance System - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the values for your environment.

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/legal_assistant
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus (Vector Database)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ChromaDB (local fallback)
CHROMA_PERSIST_DIRECTORY=./chroma_data

# DeepSeek LLM
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI LLM
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Default LLM provider
LLM_PROVIDER=deepseek

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Elasticsearch
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=legal_

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Proxy Pool (IP代理池)
PROXY_POOL_ENABLED=false
PROXY_POOL_URL=http://proxy_pool:5010

# HuggingFace Token (for downloading legal datasets)
HF_TOKEN=

# Data Expansion
DATA_EXPANSION_ENABLED=true